---
/**
 * One page per station: everything the data holds about it, each fact with its grade.
 * Built from the line's stations.json; nothing here is typed by hand.
 */
import Base from '../../../layouts/Base.astro';
import Masthead from '../../../components/Masthead.astro';
import Colophon from '../../../components/Colophon.astro';
import Grade from '../../../components/Grade.astro';
import LocatorMap from '../../../components/LocatorMap.astro';
import LineMark from '../../../components/LineMark.astro';
import PhotoCredit from '../../../components/PhotoCredit.astro';
import { getLine, dprLabel, lines, lineNodeId, lineBase, SITE_NAME, stationHref, positionBasis, streetViewUrl, plannedInterchanges, formatDate, sectionOf, openedOf, announcedOf, sectionName, clock, inr, videoTime, type LineId, type Station, type StationPhoto } from '../../../lib/data';
import { hasStatusPage } from '../../../lib/answers';
import '../../../styles/inner.css';

interface PageProps {
  i: number;
  lineId: LineId;
  /** The station is on the line's spur (spurStations), not on the line itself. */
  spur?: boolean;
}

export function getStaticPaths() {
  return lines.flatMap((l) => {
    const line = getLine(l.id);
    const own = line.stations.map((s, i) => ({ params: { line: l.id, id: s.id }, props: { i, lineId: l.id } as PageProps }));
    const spur = line.spurStations.map((s, i) => ({ params: { line: l.id, id: s.id }, props: { i, lineId: l.id, spur: true } as PageProps }));
    return [...own, ...spur];
  });
}

const { i, lineId, spur = false } = Astro.props as PageProps;
const line = getLine(lineId);
const { stations, spurStations, spurFrom, stationsMeta, stationPhotos, project, stages } = line;
const { label, route_short, about, copy } = line.info;
const base = lineBase(line.id);
const list = spur ? spurStations : stations;
const s: Station = list[i];
// The spur's first station steps back to the station the spur leaves from.
const prev: Station | undefined = list[i - 1] ?? (spur ? spurFrom : undefined);
const next: Station | undefined = list[i + 1];
const total = list.length;
const on = spur ? `the Line ${s.phase} spur of ${about.name}` : about.name;
const [endA, endB] = spur ? [spurFrom!.name, list.at(-1)!.name] : copy.ends;
// A line built as one says its state (Line 12: under construction); a line in parts names the part.
const section = stages.find((sec) => sec.phases?.includes(s.phase!));
// Opening mode: the station's section has opened, or has an announced opening date.
const own = sectionOf(line, s);
const opened = openedOf(own);
const announced = announcedOf(own);
const service = own?.service;
const state = opened ? `Open since ${formatDate(opened.date)}.` : copy.station_state ?? (section?.label ? `Part of ${section.label}.` : '');
type SameSite = { line: LineId; station: string };
const other = (s as { same_site_as?: SameSite }).same_site_as;
const otherLine = other && getLine(other.line);
const sameSite = other && {
  label: `${otherLine!.info.label} ${otherLine!.stations.find((x) => x.id === other.station)?.name ?? other.station}`,
  href: stationHref(other.line, other.station),
};
const loc = s.location as Station['location'] & { earlier?: { basis: string; distance_m: number }[] };
const where = positionBasis(line, s);
// Only moves a reader would notice on the map; readings within a few dozen metres are not news.
const moved = (loc.earlier ?? []).filter((e) => e.distance_m >= 50);
const ch = loc.dpr_chainage_m;
const km = (m: number) => (m / 1000).toLocaleString('en-IN', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const target = project.target_completion;
/**
 * The target that covers this station. Line 12 has one target for the whole line (and an earlier one);
 * Line 5's target covers Phase 1, and `rest_of_line` the other phases and the spur.
 */
type Target = typeof target & { scope?: string; rest_of_line?: { value: string; context: string; status: string; source_url: string } };
const t = target as Target;
const opening =
  t.scope && s.phase === 1
    ? { scope: t.scope, when: formatDate(t.value), reported: false, status: t.status, source_url: t.source_url }
    : t.scope && t.rest_of_line
      ? { scope: t.rest_of_line.context, when: t.rest_of_line.value, reported: true, status: t.rest_of_line.status, source_url: t.rest_of_line.source_url }
      : { scope: undefined, when: '', reported: true, status: target.status, source_url: target.source_url };
const site = Astro.site!.toString();
// Dated ground photos (the maintainer's, or shared with permission), when there are any; otherwise the slot waits for them.
const photos = stationPhotos[s.id] ?? [];
const [lead, ...more] = photos;
// Drone stills are 16:9 video frames; ground photos keep the 4:3 frame.
const wide = (ph: StationPhoto) => ph.width / ph.height > 1.5;
const moreTitle = more.every((ph) => ph.kind === 'drone')
  ? lead?.kind === 'drone' ? 'More from the air' : 'From the air'
  : more.some((ph) => ph.kind === 'drone') ? 'More pictures' : 'More from the ground';
// The flight past this station in the line's drone video, when there is one.
const flight = line.aerial?.stops.find((st) => st.station === s.id);

const title = `${s.name} Metro Station, ${about.name} (${route_short})`;
const description = `${s.name} is station ${s.order} of ${total} on ${on}, ${route_short}. Where it is, what is around it, interchanges and construction status, each with its source.`;

const schema: Record<string, unknown>[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_NAME, item: site },
      { '@type': 'ListItem', position: 2, name: label, item: `${site}${base.slice(1)}` },
      { '@type': 'ListItem', position: 3, name: 'Stations', item: `${site}${base.slice(1)}stations/` },
      { '@type': 'ListItem', position: 4, name: s.name, item: `${site}${base.slice(1)}stations/${s.id}/` },
    ],
  },
  {
    '@type': 'TrainStation',
    name: `${s.name} metro station`,
    ...(s.name_mr ? { alternateName: `${s.name_mr} मेट्रो स्थानक` } : {}),
    description: `${s.type} station ${s.order} of ${total} on ${on} (${route_short}). ${state}`,
    url: `${site}${base.slice(1)}stations/${s.id}/`,
    address: { '@type': 'PostalAddress', addressRegion: 'Maharashtra', addressCountry: 'IN' },
    ...(loc.lat !== null ? { geo: { '@type': 'GeoCoordinates', latitude: loc.lat, longitude: loc.lng } } : {}),
    containedInPlace: { '@id': lineNodeId(site, line) },
  },
];
---

<Base title={title} description={description} schema={schema} line={line}>
  <Masthead line={line} home={false} />
  <main id="main" class="page inner">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">All lines</a></li>
        <li><a href={base}>{label}</a></li>
        <li><a href={`${base}stations/`}>Stations</a></li>
        <li aria-current="page">{s.name}</li>
      </ol>
    </nav>

    <div class="inner__lead">
      <header class="inner__head">
        <h1 class="inner__title">{s.name} metro station</h1>
        {s.name_mr && <p class="inner__mr mr" lang="mr">{s.name_mr} मेट्रो स्थानक</p>}
        <p class="inner__standfirst">
          Station {s.order} of {total} on {on}, {copy.runs}.{' '}
          {s.type}. {state}
        </p>
      </header>

      {lead ? (
        <figure class:list={['shot', wide(lead) && 'shot--wide']}>
          <img src={lead.src} alt={lead.alt} width={lead.width} height={lead.height} decoding="async" />
          <figcaption>
            {lead.caption && <span>{lead.caption}</span>}
            <PhotoCredit photo={lead} />
          </figcaption>
        </figure>
      ) : (
        <figure class="shot shot--empty">
          <div class="shot__frame">
            <svg viewBox="0 0 48 36" aria-hidden="true" focusable="false">
              <rect x="2" y="7" width="44" height="27" rx="2" fill="none" stroke="currentColor" stroke-width="2.5" />
              <path d="M16 7l3-5h10l3 5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
              <circle cx="24" cy="20" r="7" fill="none" stroke="currentColor" stroke-width="2.5" />
            </svg>
            <p class="shot__empty-head">No ground photo yet</p>
            <p>Dated photos of {s.name} from the street will appear here.</p>
          </div>
        </figure>
      )}
    </div>

    <dl class="facts">
      <div>
        <dt>Where</dt>
        <dd>
          {loc.lat !== null ? (
            <>
              <p class="num">{loc.lat.toFixed(5)}, {loc.lng!.toFixed(5)} ({where})</p>
              <p>
                <a href={`${base}?station=${s.id}#map`}>See it on the map</a>
                <span aria-hidden="true"> / </span>
                <a href={`https://www.openstreetmap.org/?mlat=${loc.lat}&mlon=${loc.lng}#map=17/${loc.lat}/${loc.lng}`} target="_blank" rel="noopener">OpenStreetMap<span class="visually-hidden"> (opens in a new tab)</span></a>
                {(s as { street_view?: unknown }).street_view && (
                  <>
                    <span aria-hidden="true"> / </span>
                    <a href={streetViewUrl(s)!} target="_blank" rel="noopener">Street View of the station<span class="visually-hidden"> (opens in a new tab)</span></a>
                  </>
                )}
                {flight && (
                  <>
                    <span aria-hidden="true"> / </span>
                    <a href={`${base}?flight=${s.id}#from-the-air`}>The drone flight past it, from {videoTime(flight.t)}</a>
                  </>
                )}
              </p>
            </>
          ) : (
            <p>Position not yet mapped.</p>
          )}
          {moved.map((e) => (
            <p class="fact__note">{cap(e.basis)} put it {e.distance_m.toLocaleString('en-IN')} m from here.</p>
          ))}
          <p class="grades"><Grade status={loc.status} source={loc.source_url} /></p>
        </dd>
      </div>

      <div>
        <dt>Along the line</dt>
        <dd>
          {loc.lat !== null && <LocatorMap line={line} station={s} />}
          {loc.along_m !== null && (
            <p>
              {km(loc.along_m)} km {spur ? `along the spur from ${spurFrom!.name}` : `from the start of the line at ${stations[0].name}`}
              {ch != null && <span class="fact__note num"> ({cap(dprLabel(line).replace(/^the /, ''))}: chainage {ch.toLocaleString('en-IN')} m)</span>}
            </p>
          )}
        </dd>
      </div>

      <div>
        <dt>Next stations</dt>
        <dd>
          <ul>
            {prev && <li>Towards {endA}: <a href={`${base}stations/${prev.id}/`}>{prev.name}</a></li>}
            {next && <li>Towards {endB}: <a href={`${base}stations/${next.id}/`}>{next.name}</a></li>}
            {!prev && <li>{s.name} is the first station{s.name === endA ? '' : `, at the ${endA} end`}.</li>}
            {!next && <li>{s.name} is the last station{s.name === endB ? '' : `, at the ${endB} end`}.</li>}
          </ul>
        </dd>
      </div>

      <div>
        <dt>Interchange</dt>
        <dd>
          <p>{s.interchanges.value.length ? <>{s.interchanges.value.map((v, k) => <>{k > 0 && ', '}<LineMark text={v} />{v}</>)}</> : 'None announced'}</p>
          <p class="grades"><Grade status={s.interchanges.status} source={s.interchanges.source_url} /></p>
          {plannedInterchanges(s) && (
            <>
              <p>Planned: {plannedInterchanges(s)!.value.join(', ')}.</p>
              {plannedInterchanges(s)!.notes && <p class="fact__note">{plannedInterchanges(s)!.notes}</p>}
              <p class="grades"><Grade status={plannedInterchanges(s)!.status} source={plannedInterchanges(s)!.source_url} /></p>
            </>
          )}
          {sameSite && <p>Same site as <LineMark lineId={other!.line} />{sameSite.href ? <a href={sameSite.href}>{sameSite.label}</a> : sameSite.label}.</p>}
        </dd>
      </div>

      {s.context.length > 0 && (
        <div>
          <dt>Around the station</dt>
          <dd>
            <ul class="graded">
              {s.context.map((c) => (
                <li>
                  <span>{cap(c.text.replace(/^DPR: /, `In ${dprLabel(line)}: `))}</span>
                  <span class="grades"><Grade status={c.status} source={c.source_url} /></span>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      )}

      <div>
        <dt>Construction</dt>
        <dd>
          <p>{s.construction_status.value}</p>
          {s.construction_status.notes && <p class="fact__note">{s.construction_status.notes}</p>}
          <p class="grades"><Grade status={s.construction_status.status} source={s.construction_status.source_url} /></p>
        </dd>
      </div>

      <div>
        <dt>{opened ? 'Open' : 'When it opens'}</dt>
        <dd>
          {opened ? (
            <>
              <p>Open since {formatDate(opened.date)}, with the rest of {sectionName(line, own!)}. <Grade status={opened.status} source={opened.source_url} compact /></p>
              {service?.hours && <p>Trains run from {clock(service.hours.first)} to {clock(service.hours.last)}. <Grade status={service.hours.status} source={service.hours.source_url} compact /></p>}
              {service?.frequency && <p>A train every {service.frequency.peak_min} minutes at peak{service.frequency.off_peak_min && <>, every {service.frequency.off_peak_min} off-peak</>}. <Grade status={service.frequency.status} source={service.frequency.source_url} compact /></p>}
              {service?.fares && <p>A single fare costs {service.fares.min_inr === service.fares.max_inr ? `₹${inr(service.fares.min_inr)}` : `₹${inr(service.fares.min_inr)} to ₹${inr(service.fares.max_inr)}`}. <Grade status={service.fares.status} source={service.fares.source_url} compact /></p>}
            </>
          ) : announced ? (
            <p>Opens to riders on {formatDate(announced.date)}, with the rest of {sectionName(line, own!)}.</p>
          ) : opening.scope ? (
            <p>
              No date has been announced for this station on its own. For {opening.scope}, the {opening.reported ? 'reported ' : ''}target is{' '}
              {opening.when}.
            </p>
          ) : (
            <p>
              No date has been announced for this station on its own. For {label} as a whole, the reported target is{' '}
              {formatDate(target.value)}; an earlier reported target was {formatDate(target.alternatives[0].value)}.
            </p>
          )}
          {!opened && <p class="grades">{announced ? <Grade status={announced.status} source={announced.source_url} /> : <Grade status={opening.status} source={opening.source_url} />}</p>}
          {hasStatusPage(line) && <p><a href={`${base}status/`}>{label} status and opening date, answered</a></p>}
        </dd>
      </div>

      <div>
        <dt>Name</dt>
        <dd>
          <p>{s.name}{s.dpr_name && s.dpr_name !== s.name ? ` (${dprLabel(line)} calls it ${s.dpr_name})` : ''}</p>
          {s.notes && <p class="fact__note">{s.notes}</p>}
          <p class="grades"><Grade status={s.name_status} source={s.name_source_url} /></p>
          {s.name_mr ? <p>In Marathi: <span class="mr" lang="mr">{s.name_mr}</span></p> : <p>Marathi name not yet found in a source.</p>}
          <p class="grades"><Grade status={stationsMeta.names_mr_status} source={stationsMeta.names_mr_source_url} /></p>
        </dd>
      </div>
    </dl>

    {more.length > 0 && (
      <section class="inner__block" aria-labelledby="more-photos">
        <h2 id="more-photos">{moreTitle}</h2>
        <ul class="shots">
          {more.map((ph) => (
            <li>
              <figure class:list={['shot', wide(ph) && 'shot--wide']}>
                <img src={ph.src} alt={ph.alt} width={ph.width} height={ph.height} loading="lazy" decoding="async" />
                <figcaption>
                  {ph.caption && <span>{ph.caption}</span>}
                  <PhotoCredit photo={ph} />
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="inner__block fact__note">
      Facts checked <time datetime={s.last_verified}>{formatDate(s.last_verified)}</time>.{' '}
      <a href={`${base}stations/`}>All {total} stations</a>
      <span aria-hidden="true"> / </span>
      <a href={base}>The full {label} tracker</a>
    </p>
  </main>
  <Colophon line={line} stationId={s.id} />
</Base>
