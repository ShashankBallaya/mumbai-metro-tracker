---
/* Open Graph card sources: /og/hub/ and one per line (/og/line-12/). scripts/og.mjs captures each at
   1200x630 into public/og.png (the hub) and public/og-<line>.png. Not linked from the site and marked noindex. */
import '../../styles/global.css';
import { getLine, lines, formatDate, lastReviewed as siteReviewed, SITE_NAME, type LineId } from '../../lib/data';
import { schematic } from '../../lib/route';

export function getStaticPaths() {
  return [{ params: { card: 'hub' } }, ...lines.map((l) => ({ params: { card: l.id } }))];
}
const card = Astro.params.card as 'hub' | LineId;
const line = card === 'hub' ? undefined : getLine(card);
const strip = line && schematic(line, { width: 1000, top: 20, drop: 60, pad: 10, bottom: 20 });
const all = lines.map((l) => getLine(l.id));
---
<!doctype html>
<html lang="en" data-theme="dark" data-accent={line && line.info.colour !== 'line-orange' ? line.info.colour : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{SITE_NAME} card</title>
    <style>
      body { margin: 0; width: 1200px; height: 630px; overflow: hidden; background: var(--paper); }
      .card { display: grid; grid-template-rows: auto 1fr auto; height: 630px; }
      .band { background: var(--signal); color: var(--on-signal); padding: 28px 56px 18px; display: flex; align-items: flex-end; justify-content: space-between; }
      .band b { font-family: var(--font-display); font-weight: 800; font-stretch: 75%; font-size: 120px; line-height: 0.8; text-transform: uppercase; }
      .band span { font-family: var(--font-display); font-weight: 600; font-stretch: 87.5%; font-size: 30px; }
      .body { padding: 32px 56px 0; color: var(--ink); }
      .body h1 { font-size: 78px; text-transform: uppercase; line-height: 0.9; }
      .body p { margin-top: 16px; font-size: 26px; color: var(--ink-2); }
      svg { display: block; margin: 0 56px 36px; width: 1088px; height: 110px; }
      .casing { stroke: var(--signal-graphic); stroke-width: 20px; fill: none; stroke-linejoin: round; stroke-linecap: round; }
      .core { stroke: var(--paper); stroke-width: 8px; fill: none; stroke-linejoin: round; stroke-linecap: round; }
      /* The underground stretch: the casing broken by paper, as on the line pages. */
      .tunnel { stroke: var(--paper); stroke-width: 22px; fill: none; stroke-dasharray: 12px 9px; }
      .dot { fill: var(--ink); stroke: var(--paper); stroke-width: 4px; }
      /* The hub card */
      .hubcard { position: relative; height: 630px; overflow: hidden; background: #0c1422; }
      .hubcard__photo { position: absolute; inset: 0 0 auto; width: 1200px; height: 1600px; object-fit: cover; transform: translateY(-262px); }
      .hubcard::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to bottom, rgb(12 20 34 / 0.6), rgb(12 20 34 / 0.15) 30%, rgb(12 20 34 / 0) 48%); }
      .hubcard__name { position: absolute; z-index: 2; top: 30px; left: 0; right: 0; margin: 0; text-align: center; color: #f6f1e7;
        font-family: var(--font-display); font-weight: 800; font-stretch: 75%; font-size: 142px; line-height: 0.85; letter-spacing: -0.015em; text-transform: uppercase; }
      .hubcard__strip { position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; height: 104px; padding: 0 48px; background: #0c1422; color: #ece5d8;
        display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 28px; align-content: center; border-top: 8px solid #f26b1d; }
      .hubcard__url { margin: 0; font-family: var(--font-display); font-weight: 800; font-stretch: 75%; font-size: 46px; line-height: 1; text-transform: uppercase; color: #f26b1d; }
      .hubcard__marks { list-style: none; margin: 0; padding: 0; display: flex; gap: 7px; justify-self: end; align-self: center; }
      .hubcard__marks li { font-family: var(--font-display); font-weight: 800; font-stretch: 75%; font-size: 24px; line-height: 1; min-width: 44px; padding: 6px 7px 3px; text-align: center; border-radius: 3px; background: var(--signal); color: var(--on-signal); }
      .hubcard__credit { grid-column: 1 / -1; margin: 8px 0 0; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; color: #bfb7a9; }
    </style>
  </head>
  <body>
    {line && strip ? (
      <div class="card">
        <div class="band"><b>{line.info.label}</b><span>{SITE_NAME}. Unofficial</span></div>
        <div class="body">
          <h1 set:html={line.info.copy.headline_html} />
          <p>{line.info.route_short}, {line.project.length_km.value} km, {line.project.stations_count.value} stations. Every figure sourced. Facts checked {formatDate(line.lastReviewed)}.</p>
        </div>
        <svg viewBox={`0 0 ${strip.width} ${strip.height}`} preserveAspectRatio="none" aria-hidden="true">
          <path d={strip.path} class="casing" vector-effect="non-scaling-stroke" />
          {strip.branch && <path d={strip.branch.path} class="casing" vector-effect="non-scaling-stroke" />}
          <path d={strip.path} class="core" vector-effect="non-scaling-stroke" />
          {strip.branch && <path d={strip.branch.path} class="core" vector-effect="non-scaling-stroke" />}
          {strip.open && <path d={strip.open} class="casing" vector-effect="non-scaling-stroke" />}
          {strip.underground && <path d={strip.underground} class="tunnel" vector-effect="non-scaling-stroke" />}
          {strip.points.map(([x, y]) => <circle cx={x} cy={y} r="7" class="dot" vector-effect="non-scaling-stroke" />)}
        </svg>
      </div>
    ) : (
      /* The hub card: the owner's photo of the Line 2B arch at Shunya bridge (24 May 2026), the paper's name
         across its sky, and a navy strip with the address, the tracked lines and the photo credit. */
      <div class="hubcard">
        <img class="hubcard__photo" src="/photos/shunya-bridge-2026-05-24-a.jpg" alt="" />
        <h1 class="hubcard__name">{SITE_NAME}</h1>
        <div class="hubcard__strip">
          <p class="hubcard__url">mumbaimetrotracker.com</p>
          <ul class="hubcard__marks">
            {all.map((l) => <li data-accent={l.info.colour !== 'line-orange' ? l.info.colour : undefined}>{l.info.number}</li>)}
          </ul>
          <p class="hubcard__credit">Every fact sourced. Not affiliated with MMRDA. Photo: Shunya bridge, Line 2B, BKC, 24 May 2026, by Shashank Ballaya</p>
        </div>
      </div>
    )}
  </body>
</html>
