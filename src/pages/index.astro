---
/**
 * The hub: the front page of Mumbai Metro Tracker, printed in the line pages' newspaper world.
 *   1. The front: every MMR metro line on the real map, by stage, beside a fact box. The box opens on
 *      the index of lines being built and upcoming; choosing a line (on the map or in the index) prints
 *      its record there: stage, opening target, authority, size, cost and funding, tenders, latest update.
 *   2. The register: every line's record, grouped by stage (the box prints these same records).
 *   3. The latest updates across the tracked lines, and where the tracked lines meet.
 * Without JavaScript the map is a drawing of the real geometry and each index entry jumps to its record.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Colophon from '../components/Colophon.astro';
import Grade from '../components/Grade.astro';
import { getLine, lineBase, formatDate, outletName, inr, SITE_NAME, INTERCHANGE_TABLE, type LineId } from '../lib/data';
import { hasStatusPage } from '../lib/answers';
import { network, STAGES, networkReviewed, networkDrawing, bundleColours, type NetworkLine, type Stage } from '../lib/network';
import geometryRaw from '../data/network-geometry.geojson?raw';
import '../styles/hub.css';

const drawing = networkDrawing(JSON.parse(geometryRaw));
const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });

// Figures as the source gives them (32.32 km stays 32.32), at most two decimals.
const km = (v: number | null) => (v === null ? null : `${v.toLocaleString('en-IN', { maximumFractionDigits: 2 })} km`);
const rank = (s: Stage) => STAGES.findIndex((x) => x.id === s);
/** Where a line's work stands: the most advanced stage among its parts not yet running. A line with one
 *  stretch open and another being built (2B, 9) is filed with the work still going on, as partly open. */
const workStage = (l: NetworkLine): Stage => {
  const unfinished = l.parts.filter((p) => p.stage !== 'operational').map((p) => p.stage);
  return unfinished.length ? unfinished.sort((a, b) => rank(a) - rank(b))[0] : 'operational';
};
const partlyOpen = (l: NetworkLine) => workStage(l) !== 'operational' && l.parts.some((p) => p.stage === 'operational');
/** "Phase 1, Gaimukh to Cadbury Junction" reads "Phase 1"; "The whole line" reads "the whole line". */
const scopeOf = (scope?: string) => (scope ? scope.split(',')[0].replace(/^The /, 'the ') : null);
const titleOf = (l: NetworkLine) => (l.system ? l.name : `Line ${l.number}`);
const routeOf = (l: NetworkLine) => (l.system ? (l.system === l.name ? null : l.system) : l.name);
const mark = (l: NetworkLine) => l.number.replace(/^NM/, 'N');
const stageLabel = (s: Stage) => STAGES.find((x) => x.id === s)!.label;
const stageShort = (s: Stage) => STAGES.find((x) => x.id === s)!.short;
const colourStyle = (l: NetworkLine) => (l.colour ? `--c:var(--${l.colour});--on-c:var(--on-${l.colour})` : undefined);

/** A tracked line's record, from its own files. */
function record(l: NetworkLine) {
  if (!l.trackedId) return null;
  const line = getLine(l.trackedId as LineId);
  const p = line.project as unknown as Record<string, { value: unknown; status: string; source_url: string; scope?: string; label?: string } | undefined>;
  const target = p.target_completion as { value: string; status: string; source_url: string; scope?: string };
  const awarded = line.tenders
    .filter((t) => t.tender_status === 'awarded' && t.award_date)
    .sort((a, b) => (b.award_date! < a.award_date! ? -1 : 1));
  const latestAward = awarded[0];
  const firm = latestAward?.awarded_to ? line.contractors.find((c) => c.id === latestAward.awarded_to)?.name ?? null : null;
  const past = line.timeline
    .filter((e): e is typeof e & { date: string } => Boolean(e.date) && e.date! <= today && e.kind !== 'related')
    .sort((a, b) => (a.date < b.date ? 1 : -1));
  return {
    line,
    info: line.info,
    phase: p.current_phase!,
    target,
    cost: p.completion_cost_crore_inr?.value != null ? p.completion_cost_crore_inr : null,
    funding: p.funding?.value ? p.funding : null,
    tenders: line.tenders.length,
    latestAward: latestAward ? { pkg: latestAward.package, firm, value: latestAward.awarded_value_crore, date: latestAward.award_date!, status: latestAward.status, source: latestAward.source_url } : null,
    latest: past[0] ?? null,
    base: lineBase(l.trackedId as LineId),
    status: hasStatusPage(line),
  };
}

// The register runs from what is being built to what is only an idea; running lines close it.
const ORDER: Stage[] = ['under_construction', 'planned', 'proposed', 'operational', 'future'];
const groups = ORDER.map((id) => ({ id, label: stageLabel(id), lines: network.filter((l) => workStage(l) === id).map((l) => ({ l, r: record(l) })) })).filter((g) => g.lines.length);
const upcoming = groups.filter((g) => ['under_construction', 'planned', 'proposed'].includes(g.id));
const running = groups.find((g) => g.id === 'operational');

// The latest updates across the tracked lines: their timelines, newest first.
const updates = network
  .filter((l) => l.trackedId)
  .flatMap((l) =>
    getLine(l.trackedId as LineId)
      // A related project's event (Line 12's note of Line 12A) is listed once, under its own line.
      .timeline.filter((e): e is typeof e & { date: string } => Boolean(e.date) && e.date! <= today && e.kind !== 'related')
      .map((e) => ({ e, l })),
  )
  .sort((a, b) => (a.e.date < b.e.date ? 1 : -1))
  .slice(0, 10);

// Where two tracked lines meet (stations.json `same_site_as`).
const tracked = network.filter((l) => l.trackedId).map((l) => getLine(l.trackedId as LineId));
const meets = tracked.flatMap((line) =>
  [...line.stations, ...line.spurStations].flatMap((st) => {
    const o = (st as { same_site_as?: { line: string; station: string; distance_m: number } }).same_site_as;
    const other = o && tracked.find((x) => x.id === o.line);
    return other ? [{ line, st, other, otherStation: other.stations.find((x) => x.id === o.station)!, distance: o.distance_m }] : [];
  }),
);
const kalyan = meets.find((m) => m.st.id === 'kalyan');
const kapurbawdi = meets.find((m) => m.st.id === 'kapurbawdi');
const kanjur = meets.find((m) => m.st.id === 'kanjur-marg-west');

// Two more meeting points that Rohan Shanbhag's interchange table names, where the two stations stand apart.
// Distance between the two published station points, rounded to the metre.
const metres = (a: { lat: number | null; lng: number | null }, b: { lat: number | null; lng: number | null }) => {
  const r = Math.PI / 180;
  const c = Math.sin(a.lat! * r) * Math.sin(b.lat! * r) + Math.cos(a.lat! * r) * Math.cos(b.lat! * r) * Math.cos((b.lng! - a.lng!) * r);
  return Math.round(6371000 * Math.acos(Math.min(1, c)));
};
const tablePair = (lineId: LineId, stId: string, otherId: LineId, otherStId: string) => {
  const line = tracked.find((x) => x.id === lineId);
  const other = tracked.find((x) => x.id === otherId);
  const st = line?.stations.find((x) => x.id === stId);
  const otherStation = other?.stations.find((x) => x.id === otherStId);
  if (!line || !other || !st || !otherStation || st.location.lat === null || otherStation.location.lat === null) return undefined;
  return { line, st, other, otherStation, distance: metres(st.location, otherStation.location) };
};
const eeh = tablePair('line-2b', 'eeh', 'line-4', 'siddharth-colony');
const dongripada = tablePair('thane-ring', 'dongripada', 'line-4', 'dongripada');

const sourcesOf = (l: NetworkLine) => {
  const urls = [l.length.source, l.stations.source, l.agency?.source, ...l.parts.map((p) => p.source)].filter((u): u is string => Boolean(u));
  const seen = new Map<string, string>();
  for (const u of urls) if (!seen.has(outletName(u))) seen.set(outletName(u), u);
  return [...seen].map(([name, url]) => ({ name, url }));
};

const mapData = JSON.stringify(network.map((l) => ({ id: l.id, number: l.number, name: l.name, stage: l.stage, colour: l.colour ?? null })));
// The legend is a key to the strokes drawn (no counts: the register below counts lines by work stage).
const counts = STAGES.filter((s) => s.id !== 'future' && network.some((l) => l.parts.some((p) => p.stage === s.id)));

// The bundle: one stroke per primary line colour, in line-number order (bundleColours in src/lib/network.ts).
// It runs across the top of the page and bends down its left side; each section hangs off it at a stop.
// Sizes are desktop px, scaled on phones by --k in hub.css.
const BUNDLE = bundleColours;
const STROKE = 4; // px
const PITCH = 6; // px, stroke plus gap
const TW = BUNDLE.length * PITCH - (PITCH - STROKE); // width of the bundle, px
const BEND = TW + 16; // outer radius of the bend, px
const bendPaths = BUNDLE.map((c, i) => {
  const o = STROKE / 2 + i * PITCH;
  const r = BEND - o;
  return { c, d: `M${BEND} ${o} A${r} ${r} 0 0 0 ${o} ${BEND}` };
});
const k = (px: number) => `calc(${px}px * var(--k))`;
const bundleStops = BUNDLE.map((c, i) => {
  const a = i * PITCH;
  const gap = i < BUNDLE.length - 1 ? `, transparent ${k(a + STROKE)} ${k(a + PITCH)}` : '';
  return `var(--${c}) ${k(a)} ${k(a + STROKE)}${gap}`;
}).join(', ');
const bundleStyle = `--tw:${k(TW)};--bend:${k(BEND)};--stops:${bundleStops}`;

const DISCLAIMER =
  'Mumbai Metro Tracker is an independent public-interest site. It is not affiliated with, endorsed by or connected to MMRDA, MMRCL, CIDCO, MahaMetro or the Government of Maharashtra. The map uses OpenStreetMap data. Check official sources before making decisions.';
const title = `${SITE_NAME}: every Mumbai Metro line, built, building and planned`;
const description = `An unofficial, sourced tracker of the Mumbai Metro: all ${network.length} metro lines in the region on one map by stage, each with its authority, size, stage and sources, and Lines 2B, 4, 5, 6, 7A, 12 and 12A in full with tenders, funding and the latest updates.`;
---

<Base title={title} description={description}>
  <Masthead sections={[['map', 'Map'], ['lines', 'Every line'], ['updates', 'Updates'], ['meet', 'Where lines meet']]} />
  <main id="main" class="hubmain" style={bundleStyle}>
    <div class="bundle" aria-hidden="true">
      <div class="bundle__in">
        <span class="bundle__h"></span>
        <svg class="bundle__bend" viewBox={`0 0 ${BEND} ${BEND}`} width={BEND} height={BEND} focusable="false">
          {bendPaths.map((b) => <path d={b.d} style={`stroke:var(--${b.c})`} />)}
        </svg>
        <span class="bundle__v"></span>
      </div>
    </div>

    <!-- 1. The front: the map and its fact box -->
    <section id="map" class="front page" aria-label="The network map and the record of each line" data-front>
      <span class="stop stop--front" aria-hidden="true"></span>
      <div class="front__map" data-network-map data-lines={mapData} data-bounds={JSON.stringify(drawing.bounds)}>
        <svg class="front__drawing" viewBox={`0 0 ${drawing.width} ${drawing.height}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={`Drawing of the ${network.length} metro lines in the Mumbai region, by stage. The register below lists every line.`} data-drawing>
          {[...new Set(drawing.paths.map((p) => p.line))].map((id) => {
            const l = network.find((x) => x.id === id)!;
            return (
              <g class="nl" data-line={id} style={l.colour ? `--c:var(--${l.colour})` : undefined}>
                {drawing.paths.filter((p) => p.line === id).map((p) => <path d={p.d} class={`nl__path nl__path--${p.stage}`} vector-effect="non-scaling-stroke" />)}
              </g>
            );
          })}
          {drawing.labels.map((lb) => {
            const l = network.find((x) => x.id === lb.line)!;
            return <text class="nl__num" x={lb.x.toFixed(1)} y={lb.y.toFixed(1)} data-line={lb.line}>{mark(l)}</text>;
          })}
        </svg>
        <ul class="front__legend" role="list">
          {counts.map((s) => (
            <li><span class={`stroke stroke--${s.id}`} aria-hidden="true"></span>{s.label}</li>
          ))}
        </ul>
      </div>

      <aside class="box" aria-labelledby="box-title" data-box>
        <div class="box__index" data-box-index>
          <h2 id="box-title" class="box__title">Being built and upcoming</h2>
          <p class="box__lede">
            {upcoming.reduce((t, g) => t + g.lines.length, 0)} lines in the region are under construction, approved or proposed. Choose one on the map or below for its record.
          </p>
          {upcoming.map((g) => (
            <section class="box__group" aria-labelledby={`box-${g.id}`}>
              <h3 id={`box-${g.id}`} class="box__group-title"><span class={`stroke stroke--${g.id}`} aria-hidden="true"></span>{g.label}</h3>
              <ul class="pick-list" role="list">
                {g.lines.map(({ l, r }) => (
                  <li>
                    <a class="pick" href={`#${l.id}`} data-pick={l.id} style={colourStyle(l)}>
                      <span class:list={['lmark', !l.colour && 'lmark--none']} aria-hidden="true">{mark(l)}</span>
                      <span class="pick__name">{titleOf(l)}{routeOf(l) && <span class="pick__route">{routeOf(l)}{partlyOpen(l) && <span class="pick__open">, partly open</span>}</span>}</span>
                      <span class="pick__when">{r ? formatDate(r.target.value) : stageShort(workStage(l))}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
          {running && <p class="box__more"><a href="#stage-operational" data-plain>{running.lines.length} running lines</a> are in the register below.</p>}
        </div>
        <div class="box__record" data-box-record hidden>
          <button class="box__back" type="button" data-box-back>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12H5M12 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" /></svg>
            All lines
          </button>
          <div class="box__slot" data-box-slot tabindex="-1"></div>
        </div>
      </aside>
    </section>

    <!-- 2. The register: every line's record -->
    <section id="lines" class="section page" aria-labelledby="lines-title">
      <header class="section-head">
        <span class="stop" aria-hidden="true"></span>
        <h2 id="lines-title">Every line</h2>
        <p>
          All {network.length} metro lines in the Mumbai region, from those being built to those only studied. The {tracked.length} lines this site tracks in
          full carry their tenders, funding and latest update, with a link to their own tracker.
        </p>
      </header>
      {groups.map((g) => (
        <section class="stage" id={`stage-${g.id}`} aria-labelledby={`stage-${g.id}-title`}>
          <h3 id={`stage-${g.id}-title`} class="stage__title"><span class={`stroke stroke--${g.id}`} aria-hidden="true"></span>{g.label} <span class="num">{g.lines.length}</span></h3>
          <div class="records">
            {g.lines.map(({ l, r }) => (
              <article class="record" id={l.id} data-record={l.id} style={colourStyle(l)} aria-labelledby={`${l.id}-name`}>
                <header class="record__head">
                  <span class:list={['lmark', 'lmark--big', !l.colour && 'lmark--none']} aria-hidden="true">{mark(l)}</span>
                  <h4 id={`${l.id}-name`} class="record__name">
                    {titleOf(l)}
                    {r && <span class="record__mr" lang="mr" aria-hidden="true">{r.info.mark_mr}</span>}
                  </h4>
                  {routeOf(l) && <p class="record__route">{routeOf(l)}</p>}
                </header>
                <dl class="record__facts">
                  {r ? (
                    <>
                      <div><dt>Stage</dt><dd>{String(r.phase.value)} <Grade status={r.phase.status} source={r.phase.source_url} markLink /></dd></div>
                      <div><dt>Target</dt><dd><b>{formatDate(r.target.value)}</b>{scopeOf(r.target.scope) && <> for {scopeOf(r.target.scope)}</>}; a target, not an announced date <Grade status={r.target.status} source={r.target.source_url} markLink /></dd></div>
                    </>
                  ) : (
                    <div><dt>Stage</dt><dd>
                      <ul class="record__parts" role="list">
                        {l.parts.map((part) => (
                          <li><span class={`stroke stroke--${part.stage}`} aria-hidden="true"></span><span>{part.name}: {stageShort(part.stage).toLowerCase()}{part.opened && `, open since ${formatDate(part.opened)}`}{part.note && `. ${part.note.replace(/\.$/, '')}`} <Grade status={part.status} source={part.source} markLink /></span></li>
                        ))}
                      </ul>
                    </dd></div>
                  )}
                  {l.agency?.value && <div><dt>Authority</dt><dd>{l.agency.value} <Grade status={l.agency.status} source={l.agency.source} markLink /></dd></div>}
                  {(km(l.length.value) || l.stations.value !== null) && (
                    <div><dt>Size</dt><dd>
                      {km(l.length.value) && <><b>{km(l.length.value)}</b> <Grade status={l.length.status} source={l.length.source} markLink /></>}
                      {l.stations.value !== null && <>{km(l.length.value) && ', '}<b>{l.stations.value}</b> stations <Grade status={l.stations.status} source={l.stations.source} markLink /></>}
                    </dd></div>
                  )}
                  {r?.cost && <div><dt>Cost</dt><dd><b>₹{inr(Number(r.cost.value))} crore</b>{r.cost.label && <span class="record__note">, {String(r.cost.label).charAt(0).toLowerCase() + String(r.cost.label).slice(1)}</span>} <Grade status={r.cost.status} source={r.cost.source_url} markLink /></dd></div>}
                  {r?.funding && <div><dt>Funding</dt><dd>{String(r.funding.value)} <Grade status={r.funding.status} source={r.funding.source_url} markLink /></dd></div>}
                  {r && r.tenders > 0 && (
                    <div><dt>Tenders</dt><dd>
                      <b>{r.tenders}</b> traced{r.latestAward && <>; latest award {r.latestAward.pkg}{r.latestAward.firm && ` to ${r.latestAward.firm}`}{r.latestAward.value != null && <>, <b>₹{inr(r.latestAward.value)} cr</b></>}, {formatDate(r.latestAward.date)} <Grade status={r.latestAward.status} source={r.latestAward.source} markLink /></>}
                    </dd></div>
                  )}
                  {r?.latest && <div><dt>Latest</dt><dd>{formatDate(r.latest.date)}: {r.latest.title} <Grade status={r.latest.status} source={r.latest.source_url} markLink /></dd></div>}
                  {!r && sourcesOf(l).length > 0 && (
                    <div><dt>Sources</dt><dd>{sourcesOf(l).map((s, i) => <>{i > 0 && ', '}<a href={s.url} target="_blank" rel="noopener">{s.name}<span class="visually-hidden"> (opens in a new tab)</span></a></>)}</dd></div>
                  )}
                </dl>
                {r && (
                  <p class="record__links">
                    <a class="record__open" href={r.base}>Open the {r.info.label} tracker</a>
                    {r.tenders > 0 && <a href={`${r.base}#tenders`}>Tenders</a>}
                    <a href={`${r.base}stations/`}>Stations</a>
                    {r.status && <a href={`${r.base}status/`}>Status, answered</a>}
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}
      <p class="lines__foot">
        Network last checked {formatDate(networkReviewed)}. Routes from MMRDA's alignment files, the Thane ring project's map and OpenStreetMap (Line 3, Navi
        Mumbai Line 1). A line with no published route is listed but not drawn. Stages are this site's reading of the sources; see the grade on each.
      </p>
    </section>

    <!-- 3. Latest updates across the tracked lines -->
    <section id="updates" class="section page" aria-labelledby="updates-title">
      <header class="section-head">
        <span class="stop" aria-hidden="true"></span>
        <h2 id="updates-title">Latest updates</h2>
        <p>The newest milestones on the lines this site tracks in full, each linked to its report.</p>
      </header>
      <ol class="updates" role="list">
        {updates.map(({ e, l }) => (
          <li class="update" style={colourStyle(l)}>
            <time class="update__date" datetime={e.date}>{formatDate(e.date)}</time>
            <span class="lmark" aria-hidden="true">{mark(l)}</span>
            <p class="update__body">
              <a href={e.source_url} target="_blank" rel="noopener" class="update__title">{e.title}<span class="visually-hidden"> (opens in a new tab)</span></a>
              <span class="update__meta">{titleOf(l)} · {outletName(e.source_url)} <Grade status={e.status} source={e.source_url} compact noSource /></span>
            </p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 4. Where the tracked lines meet -->
    {(kalyan || kapurbawdi || kanjur || eeh || dongripada) && (
      <section id="meet" class="section page" aria-labelledby="meet-title">
        <header class="section-head">
        <span class="stop" aria-hidden="true"></span>
          <h2 id="meet-title">Where the lines meet</h2>
          <p>Stations where two tracked lines come together, measured between the two published station points.</p>
        </header>
        <div class="meet">
          {kalyan && (
            <p>
              <b>Kalyan.</b> Lines 12 and 5 both end by the railway junction.{' '}
              <a href={`${lineBase(kalyan.line.id)}stations/${kalyan.st.id}/`}>{kalyan.line.info.label}'s {kalyan.st.name}</a> station is planned about {kalyan.distance} m from{' '}
              <a href={`${lineBase(kalyan.other.id)}stations/${kalyan.otherStation.id}/`}>{kalyan.other.info.label}'s {kalyan.otherStation.name}</a>.
            </p>
          )}
          {kapurbawdi && (
            <p>
              <b>Kapurbawdi.</b> Line 5 starts at a station built as part of Line 4.{' '}
              <a href={`${lineBase(kapurbawdi.line.id)}stations/${kapurbawdi.st.id}/`}>{kapurbawdi.line.info.label}'s {kapurbawdi.st.name}</a> point is {kapurbawdi.distance} m from{' '}
              <a href={`${lineBase(kapurbawdi.other.id)}stations/${kapurbawdi.otherStation.id}/`}>{kapurbawdi.other.info.label}'s {kapurbawdi.otherStation.name}</a>.
            </p>
          )}
          {kanjur && (
            <p>
              <b>Kanjurmarg.</b> Line 6 crosses Line 4 on LBS Marg.{' '}
              <a href={`${lineBase(kanjur.line.id)}stations/${kanjur.st.id}/`}>{kanjur.line.info.label}'s {kanjur.st.name}</a> point is {kanjur.distance} m from{' '}
              <a href={`${lineBase(kanjur.other.id)}stations/${kanjur.otherStation.id}/`}>{kanjur.other.info.label}'s {kanjur.otherStation.name}</a>.
            </p>
          )}
          {eeh && (
            <p>
              <b>EEH and Siddharth Colony.</b> Line 2B meets Line 4.{' '}
              <a href={`${lineBase(eeh.line.id)}stations/${eeh.st.id}/`}>{eeh.line.info.label}'s {eeh.st.name}</a> point is {eeh.distance} m from{' '}
              <a href={`${lineBase(eeh.other.id)}stations/${eeh.otherStation.id}/`}>{eeh.other.info.label}'s {eeh.otherStation.name}</a>.
            </p>
          )}
          {dongripada && (
            <p>
              <b>Dongripada.</b> The Thane Ring meets Line 4.{' '}
              <a href={`${lineBase(dongripada.line.id)}stations/${dongripada.st.id}/`}>The ring's {dongripada.st.name}</a> point is {dongripada.distance} m from{' '}
              <a href={`${lineBase(dongripada.other.id)}stations/${dongripada.otherStation.id}/`}>{dongripada.other.info.label}'s {dongripada.otherStation.name}</a>.
            </p>
          )}
          {(eeh || dongripada) && (
            <p class="meet__credit">
              The interchanges at EEH and Dongripada are also in the interchange table by {INTERCHANGE_TABLE.credit} (<a href={INTERCHANGE_TABLE.href} rel="noopener" target="_blank">@{INTERCHANGE_TABLE.handle}<span class="visually-hidden"> on X (opens in a new tab)</span></a>), with news reports.
            </p>
          )}
        </div>
      </section>
    )}
  </main>
  <Colophon disclaimer={DISCLAIMER} />
</Base>

