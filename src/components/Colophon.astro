---
/**
 * The back page on every page: the paper's name and disclaimer, the lines it tracks, the drawing of an
 * elevated line with the road below as light trails, then the dateline (dates, source code, maintainer).
 * On a station page the photo credits come first.
 */
import { PRESS } from '../lib/press';
import { formatDate, lastReviewed as siteReviewed, REPO_URL, CORRECTION_URL, SITE_NAME, lines, lineBase, photoContributorsFor, type Line } from '../lib/data';
import LineMark from './LineMark.astro';
import BackPageScene from './BackPageScene.astro';

interface Props {
  /** The line this page is about. Off a line page, dates are site-wide. */
  line?: Line;
  /** The station page this footer closes. Photo credits show only on the page whose photos they are. */
  stationId?: string;
  /** A page's own disclaimer (the hub's names its photos), in place of the line's or the default. */
  disclaimer?: string;
}
const { line, stationId, disclaimer: pageDisclaimer } = Astro.props;
const lastReviewed = line?.lastReviewed ?? siteReviewed;
const credits = line && stationId ? photoContributorsFor(line, stationId) : [];
const stationName = line?.stations.find((s) => s.id === stationId)?.name;

// Build date in India time, so it matches the edition date readers see.
const builtAt = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
// The line's own disclaimer (lines.json copy), since a line may show a maker's image; this one off a line page.
const DISCLAIMER = 'Mumbai Metro Tracker is an independent public-interest site. It is not affiliated with, endorsed by or connected to MMRDA or the Government of Maharashtra. Drawings are original illustrations, not official designs. Check official sources before making decisions.';
const disclaimer = pageDisclaimer ?? line?.info.copy.footer_disclaimer ?? DISCLAIMER;
// The latest press story. The footer links our thank-you page, which links the story.
const press = PRESS[0];
---

<footer class="colophon" data-back-page>
  <div class="page colophon__inner">
    {credits.length > 0 && (
      <section class="thanks" aria-labelledby="thanks-head">
        <h2 id="thanks-head" class="visually-hidden">Photo credits</h2>
        <ul class="thanks__list">
          {credits.map((c) => (
            <li>
              <p class="thanks__name">{c.credit}</p>
              <p class="thanks__line">
                <a class="thanks__handle" href={c.href} rel="noopener" target="_blank">{c.label}<span class="visually-hidden">{c.site && ` on ${c.site}`} (opens in a new tab)</span></a>
                <span>{c.what} of {stationName} station on this page, shared with permission. Thank you.</span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}
    <div class="back">
      <div class="back__name">
        <p class="back__wordmark"><a href="/">{SITE_NAME}</a> <span lang="mr" aria-hidden="true">मुंबई मेट्रो</span></p>
        <p class="colophon__disclaimer">
          <strong>Unofficial.</strong> {disclaimer}
        </p>
        <p class="colophon__press">
          <span class="colophon__press-label">Featured in</span>
          <a href={`/press/${press.slug}/`}>{press.outlet}</a>
          <span class="colophon__press-date">{formatDate(press.date)}</span>
        </p>
      </div>
      <nav class="back__col" aria-labelledby="back-lines">
        <h2 id="back-lines" class="back__head">The lines</h2>
        <ul role="list">
          {lines.map((l) => (
            <li><a href={lineBase(l.id)}><LineMark lineId={l.id} /><span>{l.label}<small>{l.route_short}</small></span></a></li>
          ))}
        </ul>
      </nav>
      <nav class="back__col" aria-labelledby="back-paper">
        <h2 id="back-paper" class="back__head">The paper</h2>
        <ul role="list">
          <li><a href="/#map">The network map</a></li>
          <li><a href="/#lines">Every line in the region</a></li>
          <li><a href="/#updates">Latest updates</a></li>
          <li><a href="/send/">Send a photo or update</a></li>
          <li><a href={CORRECTION_URL} rel="noopener" target="_blank">Send a correction<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          <li><a href={REPO_URL} rel="noopener" target="_blank">Source code<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        </ul>
      </nav>
    </div>
  </div>
  <BackPageScene />
  <div class="page colophon__foot">
    <p class="colophon__meta">
      Data last reviewed <time datetime={lastReviewed}>{formatDate(lastReviewed)}</time>
      <span aria-hidden="true">/</span>
      Page built <time datetime={builtAt}>{formatDate(builtAt)}</time>
      <span aria-hidden="true">/</span>
      Drawing: an original illustration, not an official design
    </p>
    <p class="colophon__credit">
      Maintained by{' '}
      <a href="https://x.com/SBallaya" rel="noopener me" target="_blank">@SBallaya<span class="visually-hidden"> on X (opens in a new tab)</span></a>
    </p>
  </div>
</footer>

<style>
  .colophon {
    margin-top: var(--s-8);
    background: var(--paper-2);
    border-top: var(--bar) solid var(--signal);
  }
  .colophon__inner {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-7) 0;
  }
  /* The back page's head: the paper's name and disclaimer, then two columns of links. */
  .back {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 0.8fr);
    gap: var(--s-6) var(--s-7);
    align-items: start;
  }
  .back__name {
    display: grid;
    gap: var(--s-4);
  }
  .back__wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-4);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .back__wordmark a {
    color: var(--ink);
    text-decoration: none;
  }
  .back__wordmark span {
    font-family: 'Anek Devanagari Mark', var(--font-display);
    font-weight: 700;
    font-size: 0.6em;
    font-stretch: 100%;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .back__head {
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-3);
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-1);
    line-height: 1;
    text-transform: uppercase;
  }
  .back__col ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .back__col li + li {
    border-top: var(--rule-w) solid var(--rule);
  }
  .back__col a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    padding-block: var(--s-1);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .back__col a > span {
    display: grid;
    line-height: 1.2;
  }
  .back__col small {
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--ink-2);
  }
  @media (hover: hover) and (pointer: fine) {
    .back__col a:hover > span,
    .back__col a:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.2em;
    }
    .back__col a:hover small {
      text-decoration: none;
    }
  }
  @media (max-width: 63.99rem) {
    .back {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .back__name {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 36rem) {
    .back {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* The dateline under the drawing. */
  .colophon__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3) var(--s-6);
    padding-block: var(--s-4) var(--s-6);
    border-top: var(--rule-heavy) solid var(--rule-strong);
  }
  /* Photo credits: the section-head bar, then the name in display type. */
  .thanks {
    display: grid;
    gap: var(--s-4);
    padding-bottom: var(--s-6);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .thanks::before {
    content: '';
    width: 4.5rem;
    height: var(--bar);
    background: var(--signal-graphic);
  }
  .thanks__list {
    display: grid;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .thanks__list li {
    display: grid;
    gap: var(--s-2);
  }
  .thanks__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-4);
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .thanks__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-4);
    color: var(--ink-2);
  }
  .thanks__handle {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--ink);
  }
  .colophon__disclaimer {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  /* Press line: a small caps label, the outlet in display type, then the date. */
  .colophon__press {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
    padding-top: var(--s-3);
    border-top: var(--rule-w) solid var(--rule);
    max-width: var(--measure);
  }
  .colophon__press-label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .colophon__press a {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 87.5%;
    font-size: var(--step-1);
    color: var(--ink);
  }
  .colophon__press-date {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .colophon__credit {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 87.5%;
    font-size: var(--step-1);
  }
  .colophon__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
</style>
