---
import Grade from './Grade.astro';
import LeadPicture from './LeadPicture.astro';
import LeadPictureKasheli from './LeadPictureKasheli.astro';
import { formatDate, lineBase, openedOf, announcedOf, sectionSubject, clock, frequencyText, type Line } from '../lib/data';
import { schematic } from '../lib/route';
import { hasStatusPage } from '../lib/answers';

interface Props {
  line: Line;
}
const { line } = Astro.props;
const { project, stations } = line;


const target = project.target_completion;
const progress = project.progress;
const pct = (name: string) => Math.round(progress.items.find((i) => i.activity.startsWith(name))!.percent_complete);

// Opening mode: the first section of the line is the one the countdown is about. Once it has an
// announced opening date the countdown runs to that date; once that day comes, the box says it is open.
const firstSection = line.stages[0];
const opened = openedOf(firstSection);
const announced = announcedOf(firstSection);
const service = firstSection?.service;
const countTo = announced?.date ?? target.countdown_date;

// Build-time value; the countdown script refreshes it in the browser.
const msPerDay = 86_400_000;
const daysLeft = Math.max(0, Math.ceil((Date.parse(`${countTo}T23:59:59+05:30`) - Date.now()) / msPerDay));
const t = target as typeof target & { rest_of_line?: { value: string } };
const earlier = t.alternatives?.[0];
const copy = line.info.copy;
/** The line's own wording (lines.json `copy`), with figures from project.json. */
const fill = (text: string) =>
  text
    .replace('{stations}', String(project.stations_count.value))
    .replace('{as_of}', formatDate(progress.as_of))
    .replace(/\{pct:([^}]+)\}/g, (_, name: string) => String(pct(name)))
    .replace('{target}', formatDate(target.value))
    .replace('{earlier}', earlier ? formatDate(earlier.value) : '')
    // A range like "2030-31" stays on one line.
    .replace('{rest}', t.rest_of_line ? `<span class="nowrap">${t.rest_of_line.value}</span>` : '');
const first = stations[0].name;
const last = stations[stations.length - 1].name;

// Schematic strip (shared geometry with the route ride).
const { width: W, height: H, path, points: dots, placed, underground, open, branch, extension } = schematic(line);
const spurEnd = line.spurStations.at(-1)?.name;
---

<section class={copy.lead_scene ? 'front page' : 'front front--no-picture page'} aria-labelledby="front-headline">
  <div class="front__lead">
    <h1 id="front-headline" class="front__headline" data-split set:html={copy.headline_html} />
    <p class="front__standfirst">{fill(copy.front_standfirst)}</p>
    <p class="front__grade"><Grade status={progress.status} source={progress.source_url} /></p>
    <a class="front__ride" href="#route" data-magnetic>
      Ride the line
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v15M5 12l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" /></svg>
    </a>
  </div>

  <aside class="front__countdown" aria-labelledby="countdown-title">
    {opened ? (
      <>
        <h2 id="countdown-title" class="front__countdown-title">Open to riders</h2>
        <p class="front__days front__days--date num">{formatDate(opened.date)}</p>
        <p class="front__target">
          {sectionSubject(line, firstSection)} opened on <strong>{formatDate(opened.date)}</strong>.
          {service?.hours && <> Trains run from {clock(service.hours.first)} to {clock(service.hours.last)}.</>}
          {service?.frequency && <> Every {frequencyText(service.frequency)}.</>}
          {t.rest_of_line && <> The rest of the line has a reported target of <span class="nowrap">{t.rest_of_line.value}</span>.</>}
        </p>
        <p><Grade status={opened.status} source={opened.source_url} /></p>
      </>
    ) : announced ? (
      <>
        <h2 id="countdown-title" class="front__countdown-title">Days to opening</h2>
        <p class="front__days num" data-countdown={countTo} aria-live="off">
          <span data-countdown-value>{daysLeft.toLocaleString('en-IN')}</span>
        </p>
        <p class="front__target">
          {sectionSubject(line, firstSection)} opens to riders on <strong>{formatDate(announced.date)}</strong>.
          {t.rest_of_line && <> The rest of the line has a reported target of <span class="nowrap">{t.rest_of_line.value}</span>.</>}
        </p>
        <p><Grade status={announced.status} source={announced.source_url} /></p>
      </>
    ) : (
      <>
        <h2 id="countdown-title" class="front__countdown-title">{copy.countdown_title}</h2>
        <p class="front__days num" data-countdown={target.countdown_date} aria-live="off">
          <span data-countdown-value>{daysLeft.toLocaleString('en-IN')}</span>
        </p>
        <p class="front__target" set:html={fill(copy.target_html)} />
        <p><Grade status={target.status} source={target.source_url} /></p>
      </>
    )}
    {hasStatusPage(line) && <p class="front__status"><a href={`${lineBase(line.id)}status/`}>Opening date and status, answered</a></p>}
  </aside>

  {copy.lead_scene && (
    <div class="front__picture scene-host" data-scene={copy.lead_scene} data-line-number={line.id === 'line-12' ? undefined : line.info.number}>
      {copy.lead_scene === 'kasheli' ? (
        <LeadPictureKasheli number={line.info.number} label={line.info.label} caption={(copy as { lead_caption?: string }).lead_caption} />
      ) : (
        <LeadPicture number={line.info.number} label={line.info.label} />
      )}
    </div>
  )}

  <a class={branch ? 'front__strip front__strip--branch' : 'front__strip'} href="#route">
    <span class="front__strip-end front__strip-end--a">{first}</span>
    <svg class="front__strip-line" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d={path} class="line-casing" vector-effect="non-scaling-stroke" />
      {branch && <path d={branch.path} class="line-casing" vector-effect="non-scaling-stroke" />}
      <path d={path} class="line-core" vector-effect="non-scaling-stroke" />
      {branch && <path d={branch.path} class="line-core" vector-effect="non-scaling-stroke" />}
      {open && <path d={open} class="line-open" vector-effect="non-scaling-stroke" />}
      {underground && <path d={underground} class="line-tunnel" vector-effect="non-scaling-stroke" />}
    </svg>
    <span class="front__strip-dots" aria-hidden="true">
      {dots.map(([x, y], i) => <span class={placed[i] ? 'front__strip-dot' : 'front__strip-dot front__strip-dot--unplaced'} style={`left:${(x / W) * 100}%;top:${(y / H) * 100}%`}></span>)}
      {branch?.points.map(([x, y]) => <span class="front__strip-dot" style={`left:${(x / W) * 100}%;top:${(y / H) * 100}%`}></span>)}
      {extension && <span class="front__strip-joint" style={`left:${(extension.joint[0] / W) * 100}%;top:${(extension.joint[1] / H) * 100}%`}></span>}
      {extension && <span class="front__strip-shield" style={`left:${(extension.shield[0] / W) * 100}%;top:${(extension.shield[1] / H) * 100}%`}>{extension.label}</span>}
    </span>
    <span class="front__strip-end front__strip-end--b">{last}</span>
    {branch && <span class="front__strip-end front__strip-end--spur">{spurEnd}</span>}
    <span class="front__strip-meta num">{stations.length} stations<span aria-hidden="true"> / </span>{(project.length_km as { with_4a_km?: number }).with_4a_km ?? project.length_km.value} km<span class="visually-hidden">. Ride the line.</span></span>
  </a>
</section>

<style>
  .front {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
    padding-block: var(--s-7) var(--s-8);
  }
  @media (min-width: 64rem) {
    .front {
      grid-template-columns: minmax(0, 1.45fr) minmax(20rem, 1fr);
      grid-template-areas:
        'lead pic'
        'lead count'
        'strip strip';
      column-gap: var(--s-7);
      row-gap: var(--s-5);
      padding-block: var(--s-6) var(--s-7);
    }
    .front__lead { grid-area: lead; }
    .front__countdown { grid-area: count; }
    .front__picture { grid-area: pic; align-self: start; }
    /* No lead picture yet (Line 5): the countdown takes the picture's place. */
    .front--no-picture .front__countdown { grid-row: 1 / 3; align-self: start; }
    .front__strip { grid-area: strip; }
    .front__countdown {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--s-5);
      align-items: end;
    }
    .front__countdown-title,
    .front__countdown > p:last-child {
      grid-column: 1 / -1;
    }
  }
  .front__lead {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }
  .front__headline {
    font-size: var(--step-4);
    text-transform: uppercase;
    line-height: 0.88;
  }
  .front__standfirst {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .front__ride {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 48px;
    padding: var(--s-2) var(--s-5);
    background: var(--signal);
    color: var(--on-signal);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-1);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: translate 0.35s var(--ease-out), scale 0.16s var(--ease-out);
  }
  .front__ride svg {
    width: 1.3em;
    height: 1.3em;
    transition: transform 0.2s var(--ease-out);
  }
  .front__ride:active {
    scale: 0.97;
  }
  @media (hover: hover) and (pointer: fine) {
    .front__ride:hover svg {
      transform: translateY(3px);
    }
  }
  .front__countdown {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-4);
    border-top: var(--rule-heavy) solid var(--rule-strong);
  }
  .front__countdown-title {
    font-size: var(--step-1);
    text-transform: uppercase;
  }
  .front__days {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-4);
    line-height: 0.85;
    color: var(--ink);
  }
  /* Open: the opening date in place of the days, a size down so "20 Dec 2026" fits a phone. */
  .front__days--date {
    font-size: var(--step-3);
    text-transform: uppercase;
  }
  .front__status a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
  }
  .front__target {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.45;
    max-width: 38ch;
  }
  /* The front-page infographic: the whole line in one strip, a door into the ride. */
  .front__target :global(.nowrap) {
    white-space: nowrap;
  }
  .front__strip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    padding-top: var(--s-4);
    border-top: var(--rule-heavy) solid var(--rule-strong);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: var(--step-1);
  }
  .front__strip-line,
  .front__strip-dots {
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    height: 4.5rem;
  }
  .front__strip-dots {
    position: relative;
  }
  .front__strip-line .line-casing,
  .front__strip-line .line-core {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .front__strip-line .line-casing {
    stroke: var(--route-line);
    filter: var(--route-filter);
    stroke-width: 14px;
  }
  .front__strip-line .line-core {
    stroke: var(--paper);
    stroke-width: 5px;
  }
  /* In service: the hollow line filled in. */
  .front__strip-line .line-open {
    filter: var(--route-filter);
    fill: none;
    stroke: var(--route-line);
    stroke-width: 14px;
    stroke-linecap: round;
  }
  /* Underground: the hollow line drawn as a dashed outline. */
  .front__strip-line .line-tunnel {
    fill: none;
    stroke: var(--paper);
    stroke-width: 14px;
    stroke-linecap: butt;
    stroke-dasharray: 6px 5px;
  }
  /* Where an extension (Line 4A) begins, and its shield on the line. */
  .front__strip-joint {
    position: absolute;
    width: 3px;
    height: 1.9rem;
    translate: -50% -50%;
    background: var(--ink);
  }
  .front__strip-shield {
    position: absolute;
    translate: -50% -50%;
    padding: 0.1em 0.3em 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: 0.8rem;
    line-height: 1.15;
    background: var(--signal);
    color: var(--on-signal);
    outline: 2.5px solid var(--paper);
  }
  /* On a phone the extension's stations sit too close for the shield: the joint alone marks it. */
  @media (max-width: 40rem) {
    .front__strip-shield {
      display: none;
    }
  }
  .front__strip-dot {
    position: absolute;
    width: 0.85rem;
    height: 0.85rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--ink);
    border: 2.5px solid var(--paper);
    transition: scale 0.2s var(--ease-out);
  }
  /* No published position: put between its neighbours, drawn open. */
  .front__strip-dot--unplaced {
    background: var(--paper);
    border-color: var(--ink);
    border-style: dashed;
  }
  @media (hover: hover) and (pointer: fine) {
    .front__strip:hover .front__strip-dot {
      scale: 1.2;
    }
  }
  .front__strip-end--a {
    grid-area: 1 / 1;
    align-self: start;
  }
  .front__strip-end--b {
    grid-area: 1 / 3;
    align-self: end;
  }
  /* A line with a spur: the line's end at the top right, the spur's end at the bottom right. */
  .front__strip--branch .front__strip-end--b {
    align-self: start;
  }
  .front__strip-end--spur {
    grid-area: 1 / 3;
    align-self: end;
    color: var(--ink-2);
  }
  /* Phones: the line gets the full width, station names above and below it. */
  @media (max-width: 47.99rem) {
    .front__strip {
      grid-template-columns: minmax(0, 1fr);
    }
    .front__strip-end--a {
      grid-area: 1 / 1;
      justify-self: start;
    }
    .front__strip-line,
    .front__strip-dots {
      grid-column: 1;
      grid-row: 2;
      height: 4rem;
    }
    .front__strip-end--b {
      grid-area: 3 / 1;
      justify-self: end;
    }
    .front__strip--branch .front__strip-end--b {
      grid-area: 1 / 1;
      justify-self: end;
    }
    .front__strip-end--spur {
      grid-area: 3 / 1;
      justify-self: end;
    }
    .front__strip-meta {
      grid-row: 4;
    }
    .front__strip-dot {
      width: 0.62rem;
      height: 0.62rem;
      border-width: 2px;
    }
  }
  .front__strip-meta {
    grid-column: 1 / -1;
    justify-self: end;
    font-family: var(--font-body);
    font-weight: 500;
    font-stretch: 100%;
    text-transform: none;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
</style>
