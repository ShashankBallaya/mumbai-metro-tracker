---
/**
 * The back page's drawing: an elevated metro line at dusk, engraved in the paper's ink, with a rake in
 * the new lines' livery on the deck and the road below drawn as long-exposure light trails in the
 * bundle's colours. Original illustration of a generic line (no real station, train or official design).
 *
 * Layers, so scrolling stays cheap (src/lib/back-page-art.ts): the city and the deck are static SVG
 * files per edition, rasterised once; the trails and the train are thin inline strips, so the streaming
 * light repaints only the road and the train moves as one composited layer. Motion is in
 * src/scripts/back-page.ts; without it the drawing is complete.
 */
import { bundleColours } from '../lib/network';
import { W, H, WIRE, f } from '../lib/back-page-art';

// ---------- The train: six cars running right, nose at the right ----------
const CAR = 168;
const GAP = 8;
const CARS = 6;
const TRAIN_W = CARS * CAR + (CARS - 1) * GAP;
const TX = W / 2 - TRAIN_W / 2; // the train's place when it stops: centred
const TY = 216; // roof line
const TB = 300; // body bottom: the deck's top
const BAND_T = TY + 18; // window band
const BAND_B = TY + 42;
const cars = Array.from({ length: CARS }, (_, i) => {
  const x = i * (CAR + GAP);
  const nose = i === CARS - 1;
  const tail = i === 0;
  // A cab end leans out and rounds into the roof; the other cars are boxes with a rounded roof.
  const body = nose
    ? `M${x} ${TB}V${TY + 8}q0 -8 8 -8H${x + CAR - 34}q16 0 26 14l10 18q6 11 6 26V${TB}Z`
    : tail
      ? `M${x + CAR} ${TB}V${TY + 8}q0 -8 -8 -8H${x + 34}q-16 0 -26 14l-10 18q-6 11 -6 26V${TB}Z`
      : `M${x} ${TB}V${TY + 8}q0 -8 8 -8H${x + CAR - 8}q8 0 8 8V${TB}Z`;
  // A cab car's doors step back from the windscreen.
  const at = nose ? [0.12, 0.38, 0.64] : tail ? [0.36, 0.62, 0.88] : [0.18, 0.5, 0.82];
  const doors = at.map((d) => f(x + CAR * d - 12));
  // The window band runs the car's length (stopping short of a cab's windscreen); doors sit over it.
  const bandFrom = tail ? x + 46 : x + 6;
  const bandTo = nose ? x + CAR - 46 : x + CAR - 6;
  const mullions: number[] = [];
  for (let m = bandFrom + 24; m < bandTo - 6; m += 24) if (!doors.some((d) => m > d - 4 && m < d + 28)) mullions.push(f(m));
  return { x, body, doors, bandFrom, bandTo, mullions, nose, tail };
});
const PANTO = [1, 4].map((i) => cars[i].x + CAR / 2);

// ---------- The road: long-exposure trails, wide in front and narrowing into the distance ----------
// Each bundle colour is a band of strands; the bands fan out towards the viewer (bottom left).
const N = bundleColours.length;
const trailPath = (k: number) => {
  const o = k - (N - 1) / 2; // offset from the bundle's middle, in bands
  return `M-80 ${f(668 + o * 30)}C180 ${f(566 + o * 21)} 420 ${f(514 + o * 11)} 760 ${f(522 + o * 6.5)}S1340 ${f(530 + o * 3.5)} 1700 ${f(488 + o * 1.6)}`;
};
const STRANDS = [
  { d: -0.32, cls: 'trail__spark', dash: '2 9 26 6 1 12' },
  { d: -0.12, cls: 'trail__fine', dash: '40 3 6 3' },
  { d: 0, cls: 'trail__core', dash: '' },
  { d: 0.14, cls: 'trail__fine', dash: '18 5 2 5 60 4' },
  { d: 0.33, cls: 'trail__spark', dash: '1 6 9 4 30 8' },
];
const trails = bundleColours.map((c, i) => ({ c, glow: trailPath(i), strands: STRANDS.map((s) => ({ ...s, path: trailPath(i + s.d) })) }));

// Each moving part is a strip of the drawing, so its layer is no bigger than it needs to be.
const strip = (y: number, h: number) => `top:${f((y / H) * 100)}%;height:${f((h / H) * 100)}%`;
const TRAIN_Y = 190; // from above the wire to the deck
const TRAIN_H = TB - TRAIN_Y;
const ROAD_Y = 420;
const ROAD_H = H - ROAD_Y;
const ALT = "Illustration: a metro train crosses an elevated line at dusk, with the traffic below drawn as trails of light in the lines' colours.";
---

<div class="scene-frame" data-scene-frame role="img" aria-label={ALT}>
  <div class="scene">
    <img class="layer layer--day" src="/back-page/day-back.svg" alt="" width={W} height={H} loading="lazy" decoding="async" />
    <img class="layer layer--night" src="/back-page/night-back.svg" alt="" width={W} height={H} loading="lazy" decoding="async" />

    <!-- The road: long-exposure trails, one band of strands per line colour -->
    <svg class="layer layer--strip" style={strip(ROAD_Y, ROAD_H)} viewBox={`0 ${ROAD_Y} ${W} ${ROAD_H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
      {trails.map((t, i) => (
        <g class="trail" style={`--c:var(--${t.c});--i:${i}`}>
          <path d={t.glow} class="trail__glow" />
          {t.strands.map((s) => (s.dash ? <path d={s.path} class={s.cls} style={`stroke-dasharray:${s.dash}`} /> : <path d={s.path} class={s.cls} pathLength="1" />))}
        </g>
      ))}
    </svg>

    <img class="layer layer--day" src="/back-page/day-front.svg" alt="" width={W} height={H} loading="lazy" decoding="async" />
    <img class="layer layer--night" src="/back-page/night-front.svg" alt="" width={W} height={H} loading="lazy" decoding="async" />

    <!-- The train, engraved and hand-coloured in the blue, white and yellow livery of the new lines'
         rakes. Original drawing: no maker's or authority's marks. -->
    <svg class="layer layer--strip layer--train" style={strip(TRAIN_Y, TRAIN_H)} viewBox={`0 ${TRAIN_Y} ${W} ${TRAIN_H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false" data-train>
      <defs>
        <pattern id="h-rake" width="3" height="3" patternUnits="userSpaceOnUse">
          <path d="M0 0H3" class="hatch--rake" />
        </pattern>
        <linearGradient id="glass-lit" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" class="lit-a" />
          <stop offset="1" class="lit-b" />
        </linearGradient>
        <linearGradient id="beam" x1="0" x2="1">
          <stop offset="0" class="beam-a" />
          <stop offset="1" class="beam-b" />
        </linearGradient>
      </defs>
      <g transform={`translate(${f(TX)} 0)`}>
        <path d={`M${TRAIN_W + 8} ${TY + 62}L${TRAIN_W + 380} ${TY + 36}V${TB}L${TRAIN_W + 8} ${TY + 70}Z`} fill="url(#beam)" class="train__beam" />
        {cars.map((c, i) => (
          <g class="car">
            <clipPath id={`car-${i}`}><path d={c.body} /></clipPath>
            <g clip-path={`url(#car-${i})`}>
              <rect x={c.x - 2} y={TY - 2} width={CAR + 4} height={TB - TY + 4} class="rake-blue" />
              <rect x={c.x - 2} y={TY - 2} width={CAR + 4} height="11" class="rake-roof" />
              <rect x={c.x - 2} y={TY + 9} width={CAR + 4} height="3" class="rake-yellow" />
              <path d={`M${c.bandFrom} ${BAND_T}H${c.bandTo}V${BAND_B}H${c.bandFrom}Z`} class="rake-halo" />
              <path d={`M${c.bandFrom} ${BAND_T}H${c.bandTo}V${BAND_B}H${c.bandFrom}Z`} class="rake-glass" />
              <path d={c.mullions.map((m) => `M${m} ${BAND_T}V${BAND_B}`).join('')} class="rake-mullion" />
              <rect x={c.x - 2} y={TY + 48} width={CAR + 4} height="19" class="rake-white" />
              <rect x={c.x - 2} y={TY + 67} width={CAR + 4} height="4" class="rake-yellow" />
              <rect x={c.x - 2} y={TY + 48} width={CAR + 4} height={TB - TY - 48} fill="url(#h-rake)" class="rake-shade" />
              {c.doors.map((d) => (
                <g>
                  <path d={`M${d + 3} ${TY + 16}h7v28h-7ZM${d + 14} ${TY + 16}h7v28h-7Z`} class="rake-glass" />
                  <path d={`M${d} ${TB}V${TY + 13}h24V${TB}M${d + 12} ${TY + 13}V${TB}`} class="rake-ink rake-ink--thin" />
                </g>
              ))}
              {(c.nose || c.tail) && (
                <g transform={c.tail ? `translate(${2 * c.x + CAR} 0) scale(-1 1)` : undefined}>
                  <path d={`M${c.x + CAR - 42} ${TY + 12}H${c.x + CAR - 26}l12 18l6 16V${TY + 50}H${c.x + CAR - 42}Z`} class="rake-cab" />
                  <path d={`M${c.x + CAR - 74} ${TY + 10}H${c.x + CAR - 34}q16 0 26 14l10 18q6 11 6 24q0 8 -12 9L${c.x + CAR - 84} ${TY + 70}`} class="rake-sweep" />
                  <path d={`M${c.x + CAR - 9} ${TY + 58}h3M${c.x + CAR - 9} ${TY + 63}h3`} class={c.nose ? 'train__lamp' : 'train__tail'} />
                </g>
              )}
            </g>
            <path d={c.body} class="rake-ink" />
            <rect x={c.x + 28} y={TY - 7} width="44" height="7" class="rake-roof" />
            <rect x={c.x + 28} y={TY - 7} width="44" height="7" fill="url(#h-rake)" class="rake-shade" />
            <path d={`M${c.x + 28} ${TY}v-7h44v7M${c.x + CAR - 70} ${TY}v-5h36v5`} class="rake-ink rake-ink--thin" />
          </g>
        ))}
        {cars.slice(0, -1).map((c) => (
          <path d={`M${c.x + CAR} ${TY + 10}h${GAP}V${TB}h-${GAP}M${c.x + CAR + 3} ${TY + 12}V${TB}M${c.x + CAR + 5} ${TY + 12}V${TB}`} class="line line--thin" />
        ))}
        {PANTO.map((x) => <path d={`M${x - 18} ${TY - 3}L${x + 8} ${TY - 18}L${x - 10} ${WIRE + 1}M${x - 22} ${WIRE + 1}h26`} class="line line--panto" />)}
      </g>
    </svg>
  </div>
</div>

<script>
  import '../scripts/back-page.ts';
</script>

<style>
  /* The whole drawing on wide screens, always at the files' 5:2. Narrower, it keeps its scale (at
     least 62rem wide) and the frame shows its left part: the train's tail, the fan of light and the
     near piers. */
  .scene-frame {
    overflow: hidden;
  }
  .scene {
    position: relative;
    width: max(100%, 62rem);
    aspect-ratio: 5 / 2;
    color: var(--ink);
  }
  .layer {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .layer--strip {
    inset: auto 0;
    overflow: visible;
  }
  .layer--night {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .layer--day {
      display: none;
    }
    :root:not([data-theme='light']) .layer--night {
      display: block;
    }
  }
  :root[data-theme='dark'] .layer--day {
    display: none;
  }
  :root[data-theme='dark'] .layer--night {
    display: block;
  }
  .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .line--thin {
    stroke-width: 0.9;
  }
  .line--panto {
    stroke-width: 1.5;
  }
  /* The rake: flat livery colours under engraved ink, as on a hand-coloured print. */
  .rake-blue {
    fill: var(--rake-blue);
  }
  .rake-white {
    fill: var(--rake-white);
  }
  .rake-yellow {
    fill: var(--rake-yellow);
  }
  .rake-roof {
    fill: var(--rake-roof);
  }
  .rake-glass,
  .rake-cab {
    fill: var(--rake-glass);
  }
  .rake-mullion {
    stroke: var(--rake-blue);
    stroke-width: 3;
  }
  .rake-sweep {
    fill: none;
    stroke: var(--rake-yellow);
    stroke-width: 4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .rake-shade {
    opacity: 0.3;
  }
  .hatch--rake {
    stroke: var(--rake-ink);
    stroke-width: 0.6;
  }
  .rake-ink {
    fill: none;
    stroke: var(--rake-ink);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .rake-ink--thin {
    stroke-width: 0.9;
  }
  .rake-halo {
    display: none;
  }
  /* Night edition of the rake: the paint dims under night light, the saloon windows glow warm with a
     soft halo, the cab stays dark, and the outlines are engraved in the page's cream line like the
     rest of the drawing. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .scene {
      --rake-blue: #1b2f72;
      --rake-white: #8f95a6;
      --rake-yellow: #c99a1c;
      --rake-roof: #3d4456;
      --rake-ink: color-mix(in srgb, var(--ink) 62%, transparent);
    }
    :root:not([data-theme='light']) .rake-glass {
      fill: url(#glass-lit);
    }
    :root:not([data-theme='light']) .rake-halo {
      display: inline;
      fill: none;
      stroke: #ffc56b;
      stroke-width: 7;
      stroke-opacity: 0.22;
    }
    :root:not([data-theme='light']) .rake-mullion {
      stroke: #0f1a3d;
    }
    :root:not([data-theme='light']) .rake-ink--thin {
      stroke: color-mix(in srgb, var(--ink) 30%, transparent);
    }
  }
  :root[data-theme='dark'] .scene {
    --rake-blue: #1b2f72;
    --rake-white: #8f95a6;
    --rake-yellow: #c99a1c;
    --rake-roof: #3d4456;
    --rake-ink: color-mix(in srgb, var(--ink) 62%, transparent);
  }
  :root[data-theme='dark'] .rake-glass {
    fill: url(#glass-lit);
  }
  :root[data-theme='dark'] .rake-halo {
    display: inline;
    fill: none;
    stroke: #ffc56b;
    stroke-width: 7;
    stroke-opacity: 0.22;
  }
  :root[data-theme='dark'] .rake-mullion {
    stroke: #0f1a3d;
  }
  :root[data-theme='dark'] .rake-ink--thin {
    stroke: color-mix(in srgb, var(--ink) 30%, transparent);
  }
  .lit-a {
    stop-color: #ffe4a8;
  }
  .lit-b {
    stop-color: #e9a24a;
  }
  .train__lamp,
  .train__tail {
    fill: none;
    stroke-width: 5;
    stroke-linecap: round;
  }
  .train__lamp {
    stroke: var(--rake-white);
  }
  .train__tail {
    stroke: var(--net-red);
  }
  .beam-a {
    stop-color: var(--line-2b);
    stop-opacity: 0.32;
  }
  .beam-b {
    stop-color: var(--line-2b);
    stop-opacity: 0;
  }
  /* Trails: a soft wash, a printed core, fine streaks and a stipple of sparks, as on a long exposure. */
  .trail path {
    fill: none;
    stroke: var(--c);
    stroke-linecap: round;
  }
  .trail__glow {
    stroke-width: 16;
    opacity: 0.1;
  }
  .trail__core {
    stroke-width: 2.6;
  }
  .trail__fine {
    stroke-width: 1.1;
    opacity: 0.85;
  }
  .trail__spark {
    stroke-width: 1.4;
    opacity: 0.7;
  }
  /* On night paper the trails glow as they would at dusk. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .trail__glow {
      opacity: 0.2;
    }
  }
  :root[data-theme='dark'] .trail__glow {
    opacity: 0.2;
  }

  /* ---------- Motion (src/scripts/back-page.ts) ----------
     The start state applies only once the script has set data-motion="ready"; without the script,
     or with reduced motion, the drawing is complete and still. The train strip moves as one
     composited layer; only the road strip repaints while the light streams. */
  .layer--train {
    transition: translate 2.6s cubic-bezier(0.16, 1, 0.3, 1) 0.35s;
  }
  [data-motion='ready'] .layer--train {
    translate: -110% 0;
  }
  .train__beam {
    transition: opacity 0.6s var(--ease-out) 2.3s;
  }
  [data-motion='ready'] .train__beam {
    opacity: 0;
  }
  /* The trails' cores draw in, colour by colour, as the train comes. */
  .trail__core {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i) * 70ms);
  }
  [data-motion='ready'] .trail__core {
    stroke-dashoffset: 1;
  }
  .trail__fine,
  .trail__spark {
    transition: opacity 1.2s var(--ease-out) calc(0.4s + var(--i) * 70ms);
  }
  [data-motion='ready'] :is(.trail__fine, .trail__spark) {
    opacity: 0;
  }
  /* A long exposure keeps moving: streaks run one way, sparks the other, as on a two-way road.
     Linear and constant; it runs only while the drawing is on screen. */
  @keyframes trail-out {
    to {
      stroke-dashoffset: -240;
    }
  }
  @keyframes trail-in {
    to {
      stroke-dashoffset: 240;
    }
  }
  [data-flowing] .trail__fine {
    animation: trail-out 9s linear infinite;
  }
  [data-flowing] .trail__spark {
    animation: trail-in 13s linear infinite;
  }
  /* While the reader scrolls, the light holds still, so the scroll gets the whole frame. */
  [data-scrolling] .trail path {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .layer--train,
    .train__beam,
    .trail path {
      transition: none;
      animation: none;
    }
  }
</style>
